<UserControl
    x:Class="SimPe.Sims2.Views.Resource.Str.StrPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:SimPe.Sims2.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimPe.Sims2.ViewModels"
    x:DataType="m:Resource.Str.Str">
    <DockPanel>
        <TextBlock
            Margin="5,5"
            Padding="5,5"
            HorizontalAlignment="Stretch"
            Background="{StaticResource SystemControlBackgroundAccentBrush}"
            DockPanel.Dock="Top">
            String Table Wrapper
        </TextBlock>
        <StackPanel
            Margin="0,0,0,5"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <Label VerticalAlignment="Center">Format:</Label>
            <ComboBox ItemsSource="{Binding Format.Values, Mode=OneTime}" SelectedItem="{Binding Format}" />
        </StackPanel>
        <TreeDataGrid CanUserResizeColumns="true" Source="{Binding GridSource}" />
        <!-- <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ListBox Margin="5,0" ItemsSource="{Binding Items}" />
        </ScrollViewer>-->
    </DockPanel>
</UserControl>
