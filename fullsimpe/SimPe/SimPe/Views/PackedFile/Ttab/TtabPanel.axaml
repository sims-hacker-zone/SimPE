<UserControl
    x:Class="SimPe.Views.PackedFile.Ttab.TtabPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:SimPe.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimPe.ViewModels"
    x:DataType="m:PackedFile.Ttab.Ttab">
    <UserControl.Styles>
        <Style Selector=".rootpanel StackPanel">
            <Setter Property="Margin" Value="5,5" />
        </Style>
        <Style Selector=".rootpanel StackPanel &gt; Label">
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <TextBlock
            Margin="5,5"
            Padding="5,5"
            HorizontalAlignment="Stretch"
            Background="DarkBlue"
            DockPanel.Dock="Top">
            TTAB Wrapper
        </TextBlock>
        <Grid Classes="rootpanel" ColumnDefinitions="*,2,4*">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label VerticalAlignment="Center">File name:</Label>
                    <TextBox MaxLength="64" Text="{Binding FileName}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label VerticalAlignment="Center">Version:</Label>
                    <NumericUpDown Increment="1" Value="{Binding Version}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox Name="TtabItemList" ItemsSource="{Binding Items}" />
                </ScrollViewer>
            </StackPanel>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <TabControl Grid.Column="2" DataContext="{Binding #TtabItemList.SelectedItem}">
                <TabItem Header="General">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label VerticalAlignment="Center">Action:</Label>
                            <TextBox MaxLength="64" Text="{Binding Action, StringFormat=0x{0:X4}}" />
                        </StackPanel>
                    </WrapPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
