<UserControl
    x:Class="SimPe.Views.PackedFile.Clst.ClstPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:m="using:SimPe.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimPe.ViewModels"
    x:DataType="m:PackedFile.Clst.Clst">
    <DockPanel>
        <TextBlock
            Margin="5,5"
            Padding="5,5"
            HorizontalAlignment="Stretch"
            Background="DarkBlue"
            DockPanel.Dock="Top">
            CLST Wrapper
        </TextBlock>
        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <ListBox Margin="5,0" ItemsSource="{Binding Items}" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
